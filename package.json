{
  "name": "@apraamcos/pass-js",
  "author": "Konstantin Vyatkin <tino@vtkn.io>",
  "version": "7.0.1",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsgo --project tsconfig.json",
    "lint": "oxlint --type-aware && oxfmt --check src __tests__",
    "check": "pnpm run lint",
    "format": "oxfmt src __tests__",
    "test": "pnpm run build && node --test \"__tests__/*.ts\"",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@typescript/native-preview": "7.0.0-dev.20260613.1",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "oxlint-tsgolint": "^0.23.0"
  },
  "keywords": [
    "apple",
    "wallet",
    "pass",
    "passkit",
    "iOS",
    "generating",
    "APN"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apraamcos/pass-js.git"
  }
}
